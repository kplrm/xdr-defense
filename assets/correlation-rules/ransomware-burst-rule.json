{
  "name": "xdr-ransomware-burst-window",
  "type": "query",
  "schedule": { "interval": { "period": 1, "unit": "MINUTES" } },
  "inputs": [
    {
      "search": {
        "indices": ["xdr-alerts-*", "xdr-prevention-actions-*"],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                { "range": { "@timestamp": { "gte": "now-3m" } } },
                { "term": { "event.module": "detection.behavioral" } }
              ]
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "ransomware-burst-threshold",
      "severity": "1",
      "condition": {
        "script": {
          "source": "return true;"
        }
      },
      "actions": []
    }
  ]
}
